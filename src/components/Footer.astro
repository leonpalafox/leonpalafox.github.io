---
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline" lang="en">
  <div class="grid gap-10 px-6 py-12 sm:px-10 md:grid-cols-3 lg:px-14">
    <div class="space-y-3">
      <p class="text-lg font-semibold tracking-tight">León Palafox</p>
      <p class="max-w-[28ch] text-sm leading-relaxed text-muted">
        AI strategy and recommender systems for finance, from Mexico City.
      </p>
    </div>
    <nav aria-label="Footer">
      <p class="micro-label mb-4 text-muted">Site</p>
      <ul class="space-y-2 text-sm">
        <li><a class="hover:text-signal" href="/about/">About</a></li>
        <li><a class="hover:text-signal" href="/blog/">Blog</a></li>
        <li><a class="hover:text-signal" href="/teaching/">Teaching</a></li>
        <li><a class="hover:text-signal" href="/portfolio/">Portfolio</a></li>
        <li><a class="hover:text-signal" href="/publications/">Publications</a></li>
        <li><a class="hover:text-signal" href="/media/">Media</a></li>
      </ul>
    </nav>
    <div>
      <p class="micro-label mb-4 flex items-center gap-3 text-muted">
        <span>Elsewhere</span>
        <span lang="ja" class="tracking-[0.2em]">接続</span>
      </p>
      <SocialLinks />
      <p class="mt-5 text-sm text-muted">
        <a class="underline decoration-hairline underline-offset-4 hover:text-signal-deep" href="mailto:leon.palafox@gmail.com">leon.palafox@gmail.com</a>
      </p>
    </div>
  </div>
  <div class="flex items-center justify-between gap-4 border-t border-hairline px-6 py-4 sm:px-10 lg:px-14">
    <p class="micro-label text-muted">© {year} León Palafox<span class="hidden sm:inline"> — Mexico City</span></p>
    <p class="flex shrink-0 items-center gap-3">
      <span class="whitespace-nowrap border border-signal px-1.5 py-0.5 text-[0.65rem] text-signal-deep" lang="ja" title="kaizen — continuous improvement">改善</span>
      <span aria-hidden="true" class="block size-2 rounded-full bg-signal"></span>
    </p>
  </div>
</footer>
