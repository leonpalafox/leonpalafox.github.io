---
/**
 * Publishes the poll-of-polls data bundle to `window.__POP_DATA__` so the
 * interactive widgets embedded in a blog post can read it.
 *
 * Each edition must bind to ITS OWN week, not to whatever ran most recently.
 * Injecting a shared `latest.json` meant the Week 3 post silently re-rendered
 * with Week 4's numbers once the newer bundle was built, because the bundle is
 * resolved at build time for every post at once.
 *
 * So the caller passes the week it wants. Every week-stamped bundle is pulled in
 * at build time and the matching one is injected; an unknown week falls back to
 * the newest file rather than emitting nothing.
 *
 * The payload is `is:inline` because it must execute before the widgets' own
 * inline scripts, which Astro has already hoisted into the head.
 */
import latest from '../data/nfl-power-rankings-latest.json';

const bundles = import.meta.glob<{ default: Record<string, unknown> }>(
  '../data/nfl-power-rankings-2*.json',   // excludes -latest.json
  { eager: true },
);

interface Props {
  week?: number;
}

const { week } = Astro.props;
const match = week
  ? Object.entries(bundles).find(([path]) => path.endsWith(`-wk${String(week).padStart(2, '0')}.json`))
  : undefined;
const bundle = match ? match[1].default : (latest as Record<string, unknown>);
---

<script is:inline set:html={`window.__POP_DATA__ = ${JSON.stringify(bundle)};`} />
