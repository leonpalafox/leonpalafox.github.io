---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { monthDay } from '../lib/format';
import { getAsset } from '../lib/assets';

// A compact index of every AI column beyond the six shown in the Portada.
// This is what puts the full 2026 run — including the newly imported Medium
// pieces — on the landing page without turning the front page into an archive.
const allPosts = (await getCollection('blog', (post) => post.data.tags.includes('ia'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = allPosts.find((post) => post.data.featured);
const ordered = featured ? [featured, ...allPosts.filter((post) => post.id !== featured.id)] : allPosts;
const remaining = ordered.slice(6);

const thumbs = new Map(
  remaining
    .filter((post) => post.data.cover)
    .map((post) => [post.id, getAsset(post.data.cover!, { alt: '' }).src]),
);
---

{
  remaining.length > 0 && (
    <section aria-labelledby="more-columns-title" class="border-b border-hairline bg-sheet">
      <div class="px-6 pb-16 sm:px-10 lg:px-14 lg:pb-24">
        <header class="more-head">
          <div>
            <p class="micro-label text-signal-deep">
              The column <span aria-hidden="true">/</span> <span lang="ja">続き</span>
            </p>
            <h2 id="more-columns-title" class="more-title">
              More columns.
            </h2>
          </div>
          <div class="more-intro">
            <p>Every AI column beyond the six above, newest first.</p>
            <a href="/blog/" class="more-link">
              All columns <span aria-hidden="true">↗</span>
            </a>
          </div>
        </header>

        <ol class="more-list">
          {remaining.map((post) => {
            const thumb = thumbs.get(post.id);
            return (
              <li>
                <a href={`/blog/${post.id}/`} class="more-item">
                  <span class="more-date">{monthDay(post.data.pubDate)}</span>
                  {thumb ? (
                    <Image
                      src={thumb}
                      alt=""
                      aria-hidden="true"
                      widths={[52, 104]}
                      sizes="40px"
                      loading="lazy"
                      class="more-thumb"
                    />
                  ) : (
                    <span class="more-thumb more-thumb--empty" aria-hidden="true" />
                  )}
                  <span class="more-name" lang={post.data.lang}>
                    {post.data.title}
                  </span>
                  <span class="more-lang">{post.data.lang}</span>
                  <span class="more-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            );
          })}
        </ol>

        <p class="more-count">
          {String(remaining.length).padStart(2, '0')} columns · 2026
        </p>
      </div>
    </section>
  )
}

<style>
  .more-head {
    display: grid;
    gap: 2rem;
    border-top: 1px solid var(--color-ink);
    padding-top: 1.5rem;
  }

  .more-title {
    margin-top: 0.8rem;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 520;
    line-height: 0.96;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .more-intro {
    align-self: end;
    max-width: 31rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1rem;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .more-link span {
    color: var(--color-signal-deep);
    font-size: 1rem;
    transition: transform 180ms ease;
  }

  .more-link:hover span {
    transform: translate(0.15rem, -0.15rem);
  }

  .more-list {
    margin-top: 2.5rem;
  }

  .more-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--color-hairline);
  }

  .more-list li:last-child .more-item {
    border-bottom: 1px solid var(--color-hairline);
  }

  .more-date {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .more-thumb {
    display: none;
    width: 2.5rem;
    height: 1.75rem;
    border: 1px solid var(--color-hairline);
    object-fit: cover;
    filter: grayscale(0.4);
    transition: filter 200ms ease;
  }

  .more-thumb--empty {
    display: none;
    /* No cover art: a quiet plate with the site's signal dot, so the slot reads as intended. */
    background:
      radial-gradient(circle, var(--color-signal) 0 2px, transparent 2.5px),
      var(--color-paper);
  }

  .more-name {
    min-width: 0;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.3;
    transition: color 180ms ease;
  }

  .more-lang {
    display: none;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .more-arrow {
    color: var(--color-signal-deep);
    font-size: 1rem;
    transition: transform 180ms ease;
  }

  .more-item:hover .more-name {
    color: var(--color-signal-deep);
  }

  .more-item:hover .more-thumb {
    filter: grayscale(0);
  }

  .more-item:hover .more-arrow {
    transform: translateX(0.2rem);
  }

  .more-count {
    margin-top: 1rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .more-item {
      grid-template-columns: 3.25rem 2.5rem minmax(0, 1fr) auto 1rem;
    }

    .more-thumb,
    .more-thumb--empty,
    .more-lang {
      display: block;
    }
  }

  @media (min-width: 768px) {
    .more-head {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
      align-items: end;
    }

    .more-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }

    .more-list li:last-child .more-item {
      border-bottom: 0;
    }
  }
</style>
