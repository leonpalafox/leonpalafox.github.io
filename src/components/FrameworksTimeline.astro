};

/**
 * Wrap a registered mark in its own `<svg>` at a fixed height.
 *
 * `set:html` injects raw markup, so emitting the bare inner `<g>` would leave
 * orphaned elements that render as nothing.
 *
 * A viewBox-only SVG has no intrinsic width or height, and Chrome will not derive
 * one from `height: 100%` or `aspect-ratio` alone — the box collapses to zero.
 * So the pixel size is computed here from the viewBox and written into the tag,
 * which keeps a 3:1 wordmark and a 1:1 app icon on the same optical line.
 */
const svgFor = (key: string | null | undefined, height: number): string => {
  const mark = key ? marks[key] : undefined;
  if (!mark) return '';
  const [, , vbWidth, vbHeight] = mark.viewBox.split(/\s+/).map(Number);
  const width = vbWidth && vbHeight ? Math.round((vbWidth / vbHeight) * height) : height;
  return `<svg viewBox="${mark.viewBox}" width="${width}" height="${height}" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">${mark.svg}</svg>`;
};

const totalPhases = frameworks.reduce((sum, framework) => sum + framework.phases.length, 0);
const isGap = (phase: Phase) => phase.who === 'Sin proyecto' || phase.who === 'Solo investigación';
---

<section class="frameworks-timeline" aria-labelledby="ft-title" data-ft>
  <header class="ft-head">
    <p class="micro-label text-signal-deep">Quién mantiene cada framework · 2007–2020</p>
    <h2 id="ft-title" class="ft-headline">
      Todos nacieron en un laboratorio. Casi todos terminaron dentro de una empresa.
    </h2>
    <p class="ft-lede">
      Cada fila es un framework y cada barra de color es quién lo mantenía en ese periodo. Haz clic en una
      barra —o en el nombre— para leer qué pasó, dónde y cuándo. Mueve el año para ver el reparto de un
      momento concreto.
    </p>
  </header>

  <div class="ft-controls">
    <div class="ft-year">
      <label for="ft-range" class="micro-label">Año</label>
      <output id="ft-year" class="ft-year-value" for="ft-range">Todo</output>
      <input
        id="ft-range"
        class="ft-range"
        type="range"
        min={START}
        max={END}
        step="1"
        value={END}
        aria-describedby="ft-year-hint"
      />
    </div>
    <p id="ft-year-hint" class="ft-hint micro-label">
      {totalPhases} etapas · arrastra para recorrer la línea de tiempo
    </p>
    <button type="button" class="ft-reset micro-label" data-ft-reset>Ver todo</button>
  </div>

  <div class="ft-scroll">
    <div
      class="ft-grid"
      role="group"
      aria-label="Cronología de frameworks de deep learning, 2007 a 2020"
      style={`--ft-cols:${COLS}`}
      data-ft-grid
    >
      <div class="ft-corner" aria-hidden="true"><span class="micro-label">Framework</span></div>
      {
        years.map((year) => (
          <div class="ft-year-head" data-ft-col={year} aria-hidden="true">
            <span>{year}</span>
          </div>
        ))
      }

      {
        frameworks.map((framework, rowIndex) => {
          const gridRow = rowIndex + 2;
          const labelSvg = svgFor(framework.mark, 18);
          const barSvg = svgFor(framework.spanMark ?? framework.mark, 13);
          return (
            <>
              <div class="ft-rowlabel" style={`grid-row:${gridRow}`}>
                <button
                  type="button"
                  class="ft-rowbtn"
                  data-ft-row={rowIndex}
                  aria-pressed="false"
                  style={`--row-color:${framework.color}`}
                >
                  {labelSvg && <span class="ft-rowmark" aria-hidden="true" set:html={labelSvg} />}
                  <span class="ft-rowtext">
                    <span class="ft-rowname">{framework.name}</span>
                    <span class="ft-rowtype">{framework.type}</span>
                  </span>
                </button>
              </div>

              {framework.phases.map((phase, phaseIndex) => {
                const from = Math.max(phase.from, START);
                const to = Math.min(phase.to, END);
                const cols = Math.max(1, to - from + 1);
                const empty = isGap(phase);
                return (
                  <button
                    type="button"
                    class="ft-span"
                    data-ft-row={rowIndex}
                    data-ft-phase={phaseIndex}
                    data-ft-cols={cols}
                    aria-pressed="false"
                    aria-label={`${framework.name}, ${phase.from} a ${phase.to}: ${phase.who}`}
                    style={{
                      gridRow,
                      gridColumn: `${from - START + 2} / span ${cols}`,
                      '--phase-color': framework.color,
                      '--phase-ink': `color-mix(in srgb, ${framework.color} 58%, var(--color-ink))`,
                      '--phase-tint': `color-mix(in srgb, ${framework.color} 22%, var(--color-sheet))`,
                    }}
                    data-empty={empty ? 'true' : 'false'}
                    data-tight={cols <= 2 ? 'true' : 'false'}
                  >
                    <span class="ft-span-inner">
                      {barSvg && !empty && (
                        <span
                          class={framework.spanMark === 'google' ? 'ft-spanmark ft-spanmark--wide' : 'ft-spanmark'}
                          aria-hidden="true"
                          set:html={barSvg}
                        />
                      )}
                      <span class="ft-spanwho">{phase.who}</span>
                    </span>
                  </button>
                );
              })}
            </>
          );
        })
      }
    </div>
  </div>

  <p class="ft-note micro-label">
    Los cuadros punteados son periodos en los que el proyecto todavía no existía. Todo es clicable.
  </p>

  <div class="ft-detail" data-ft-detail aria-live="polite"></div>

  <ol class="ft-index">
    {
      frameworks.map((framework, rowIndex) => (
        <li>
          <button
            type="button"
            class="ft-indexbtn"
            data-ft-row={rowIndex}
            style={`--row-color:${framework.color}`}
          >
            <span class="ft-indexdot" aria-hidden="true" />
            <span class="ft-indexname">{framework.name}</span>
            <span class="ft-indextype">{framework.origin}</span>
          </button>
        </li>
      ))
    }
  </ol>
</section>

<script is:inline define:vars={{ frameworks }}>
  window.__FT_DATA__ = { frameworks };
</script>

<script>
  interface Phase {
    from: number;
    to: number;
    who: string;
    where?: string;
    status?: string;
    body: string;
    milestones?: string[];
  }

  interface Framework {
    name: string;
    type: string;
    color: string;
    mark: string | null;
    summary: string;
    origin: string;
    phases: Phase[];
  }

  const START = 2007;
  const END = 2020;
  const YEARS = Array.from({ length: END - START + 1 }, (_, i) => START + i);

  const payload = (window as unknown as { __FT_DATA__?: { frameworks: Framework[] } }).__FT_DATA__;
  const FRAMEWORKS: Framework[] = payload?.frameworks ?? [];

  /**
   * Astro scopes this component's CSS with a `data-astro-cid-*` attribute on every
   * element it renders at build time. Markup injected later by this script carries
   * none of those attributes, so every rule for the detail panel would silently
   * fail to match. The scope is read off the rendered root and stamped onto each
   * generated node.
   */
  const scopeOf = (root: HTMLElement) =>
    Array.from(root.attributes).find((attr) => attr.name.startsWith('data-astro-cid-'))?.name ?? '';
  /** Set per instance in `mount`; empty is survivable — it only costs panel styling. */
  let CID = '';

  const inSpan = (phase: Phase, year: number) => year >= phase.from && year <= phase.to;
  const spanLabel = (phase: Phase) =>
    phase.from === phase.to ? String(phase.from) : `${phase.from}–${phase.to}`;
  const isGap = (phase: Phase) => phase.who === 'Sin proyecto' || phase.who === 'Solo investigación';

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string,
    );

  /**
   * Panel markup is authored with `data-cid` placeholders and the scope is
   * substituted in once per render. Values that go into the markup are escaped
   * first (which neutralises any `@` in the data), so a plain substitution is
   * safe here.
   */
  const html = (template: string) => template.replaceAll(' data-cid', CID);
  const text = (value: string) => escapeHtml(value).replaceAll('@', '&#64;');

  /** Inline custom properties so each card inherits its framework's colours. */
  const palette = (framework: Framework) =>
    `--phase-color:${framework.color};--phase-ink:color-mix(in srgb, ${framework.color} 58%, var(--color-ink));--phase-tint:color-mix(in srgb, ${framework.color} 22%, var(--color-sheet))`;

  const positionBar = (from: number, to: number) => {
    const a = ((Math.max(from, START) - START) / (END - START)) * 100;
    const b = ((Math.min(to, END) - START + 1) / (END - START)) * 100;
    return `left:${a.toFixed(3)}%;right:${Math.max(0, 100 - b).toFixed(3)}%`;
  };

  const panelForPhase = (framework: Framework, phase: Phase, year: number | null) => {
    const facts = (phase.milestones ?? []).map((item) => `<li data-cid>${text(item)}</li>`).join('');
    const now =
      year === null
        ? ''
        : inSpan(phase, year)
          ? `En ${year} esta etapa está activa`
          : year < phase.from
            ? `En ${year} esta etapa todavía no empieza`
            : `En ${year} esta etapa ya había terminado`;
    return html(`
      <div class="ft-card" data-cid style="${palette(framework)}">
        <p class="ft-card-kicker micro-label" data-cid>${text(framework.name)} · ${text(spanLabel(phase))}</p>
        <h3 class="ft-card-title" data-cid>${text(phase.who)}</h3>
        <p class="ft-card-org micro-label" data-cid>${text(phase.where ?? framework.origin)}${
          phase.status && phase.status !== phase.who ? ` · ${text(phase.status)}` : ''
        }</p>
        <p class="ft-card-body" data-cid>${text(phase.body)}</p>
        ${facts ? `<ul class="ft-card-facts" data-cid>${facts}</ul>` : ''}
        ${now ? `<p class="ft-card-now micro-label" data-cid>${text(now)}</p>` : ''}
      </div>`);
  };

  const panelForRow = (framework: Framework, year: number | null) => {
    const tracks = framework.phases
      .map((phase) => {
        const state =
          year === null
            ? 'Etapa'
            : inSpan(phase, year)
              ? 'Activo'
              : year < phase.from
                ? 'Todavía no'
                : 'Terminado';
        const fill =
          state === 'Terminado'
            ? `color-mix(in srgb, ${framework.color} 30%, var(--color-sheet))`
            : framework.color;
        return `
          <li class="ft-track" data-cid data-state="${state === 'Activo' ? 'on' : 'off'}">
            <span class="ft-track-bar" data-cid style="${positionBar(phase.from, phase.to)};background:${fill}"></span>
            <span class="ft-track-years micro-label" data-cid>${text(spanLabel(phase))}</span>
            <span class="ft-track-state micro-label" data-cid>${state}</span>
            <span class="ft-track-who" data-cid>${text(phase.who)}${
              phase.where ? ` <span class="ft-track-where" data-cid>· ${text(phase.where)}</span>` : ''
            }</span>
          </li>`;
      })
      .join('');
    return html(`
      <div class="ft-card" data-cid style="${palette(framework)}">
        <p class="ft-card-kicker micro-label" data-cid>${text(framework.name)} · ${text(framework.type)}</p>
        <h3 class="ft-card-title" data-cid>${text(framework.origin)}</h3>
        <p class="ft-card-body" data-cid>${text(framework.summary)}</p>
        <ol class="ft-tracks" data-cid>${tracks}</ol>
        <p class="ft-card-now micro-label" data-cid>Haz clic en una barra de la gráfica para leer cada etapa</p>
      </div>`);
  };

  const panelForYear = (year: number) => {
    const rows = FRAMEWORKS.map((framework) => {
      const active = framework.phases.find((phase) => inSpan(phase, year) && !isGap(phase));
      return `
        <li class="ft-yearrow" data-cid>
          <span class="ft-yeardot" data-cid style="background:${active ? framework.color : 'transparent'};border-color:${
            active ? framework.color : 'var(--color-hairline)'
          }"></span>
          <span class="ft-yearname" data-cid>${text(framework.name)}</span>
          <span class="ft-yearwho" data-cid>${text(active ? active.who : 'Sin proyecto todavía')}</span>
        </li>`;
    }).join('');
    return html(`
      <div class="ft-card ft-card--year" data-cid>
        <p class="ft-card-kicker micro-label" data-cid>Estado del ecosistema</p>
        <h3 class="ft-card-title" data-cid>${year}</h3>
        <p class="ft-card-body" data-cid>Quién mantenía cada framework en ${year}. Elige una fila o una barra para leer la explicación completa.</p>
        <ul class="ft-yearlist" data-cid>${rows}</ul>
      </div>`);
  };

  function mount(root: HTMLElement) {
    const grid = root.querySelector<HTMLElement>('[data-ft-grid]');
    const detail = root.querySelector<HTMLElement>('[data-ft-detail]');
    const range = root.querySelector<HTMLInputElement>('#ft-range');
    const yearOut = root.querySelector<HTMLElement>('#ft-year');
    const hint = root.querySelector<HTMLElement>('#ft-year-hint');
    const reset = root.querySelector<HTMLButtonElement>('[data-ft-reset]');
    if (!grid || !detail || !range || !yearOut || !reset || FRAMEWORKS.length === 0) return;

    // Bound before the first render so the year panel is styled on load.
    const scope = scopeOf(root);
    CID = scope ? ` ${scope}` : '';

    let year: number | null = null;
    let selectedRow: number | null = null;
    let selectedPhase: number | null = null;

    const rowButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.ft-rowbtn'));
    const indexButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.ft-indexbtn'));
    const spans = Array.from(root.querySelectorAll<HTMLButtonElement>('.ft-span'));
    const heads = Array.from(root.querySelectorAll<HTMLElement>('[data-ft-col]'));

    const render = () => {
      heads.forEach((head) => {
        const column = Number(head.dataset.ftCol);
        head.classList.toggle('is-year', year !== null && column === year);
        head.classList.toggle('is-past', year !== null && column < year);
      });

      grid.classList.toggle('is-scrubbing', year !== null);
      if (year !== null) grid.style.setProperty('--ft-year-index', String(year - START));

      const rowSelected = selectedRow !== null && selectedPhase === null;
      rowButtons.forEach((button) =>
        button.classList.toggle('is-active', rowSelected && Number(button.dataset.ftRow) === selectedRow),
      );
      indexButtons.forEach((button) =>
        button.classList.toggle('is-active', rowSelected && Number(button.dataset.ftRow) === selectedRow),
      );

      spans.forEach((span) => {
        const isSelected =
          selectedPhase !== null &&
          Number(span.dataset.ftRow) === selectedRow &&
          Number(span.dataset.ftPhase) === selectedPhase;
        span.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });

      grid.classList.toggle('has-selection', selectedRow !== null);

      if (selectedRow !== null && selectedPhase !== null) {
        detail.innerHTML = panelForPhase(
          FRAMEWORKS[selectedRow],
          FRAMEWORKS[selectedRow].phases[selectedPhase],
          year,
        );
      } else if (selectedRow !== null) {
        detail.innerHTML = panelForRow(FRAMEWORKS[selectedRow], year);
      } else {
        detail.innerHTML = panelForYear(year ?? END);
      }
    };

    const revealPanel = () => {
      if (window.matchMedia('(max-width: 1023px)').matches) {
        detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    };

    const selectPhase = (row: number, phase: number) => {
      if (selectedRow === row && selectedPhase === phase) {
        selectedPhase = null;
      } else {
        selectedRow = row;
        selectedPhase = phase;
      }
      render();
      revealPanel();
    };

    const selectRow = (row: number) => {
      if (selectedRow === row && selectedPhase === null) {
        selectedRow = null;
      } else {
        selectedRow = row;
        selectedPhase = null;
      }
      render();
      revealPanel();
    };

    spans.forEach((span) =>
      span.addEventListener('click', () =>
        selectPhase(Number(span.dataset.ftRow), Number(span.dataset.ftPhase)),
      ),
    );
    rowButtons.forEach((button) =>
      button.addEventListener('click', () => selectRow(Number(button.dataset.ftRow))),
    );
    indexButtons.forEach((button) =>
      button.addEventListener('click', () => selectRow(Number(button.dataset.ftRow))),
    );

    const syncYear = () => {
      year = Number(range.value);
      yearOut.textContent = String(year);
      if (hint) hint.textContent = `Viendo ${year} · año ${year - START + 1} de ${YEARS.length}`;
      render();
    };

    range.addEventListener('input', syncYear);
    reset.addEventListener('click', () => {
      year = null;
      selectedRow = null;
      selectedPhase = null;
      range.value = String(END);
      yearOut.textContent = 'Todo';
      if (hint) hint.textContent = 'Arrastra para recorrer la línea de tiempo';
      render();
    });

    render();
  }

  document.querySelectorAll<HTMLElement>('[data-ft]').forEach(mount);
</script>

