---
/**
 * Interactive re-drawing of the "who maintained which deep learning framework"
 * chart, 2007–2020.
 *
 * The original is a flat grid with logos pasted into it. This one keeps the grid
 * but makes every row and every period a button: clicking a framework or a
 * single span opens an explanation of what happened, to whom, and when. The year
 * scrubber collapses the diagram onto one year and shows who held what.
 *
 * Figures are the documented public record — project announcements, end-of-
 * support notices, foundation transfers. Where the original chart simplified a
 * hand-off, this version splits the period at the documented date and says so.
 *
 * All marks are inlined or bundled locally, so the diagram renders without a
 * single third-party request.
 */
interface Phase {
  /** Inclusive start year. */
  from: number;
  /** Inclusive end year. */
  to: number;
  /** Who held the project during this period. */
  who: string;
  where?: string;
  status?: string;
  /** Paragraph shown in the detail panel. */
  body: string;
  /** Dated facts, rendered as a list. */
  milestones?: string[];
}

interface Framework {
  name: string;
  type: string;
  color: string;
  /** Key into `marks`: the mark shown on the row label. */
  mark: string | null;
  /** Overrides `mark` inside the timeline bars, where the maintainer matters more. */
  spanMark?: string;
  /** Panel paragraph when the whole row is selected. */
  summary: string;
  origin: string;
  phases: Phase[];
}

const START = 2007;
const END = 2020;
const years = Array.from({ length: END - START + 1 }, (_, i) => START + i);
/** 1 label column + one column per year. */
const COLS = years.length + 1;

const frameworks: Framework[] = [
