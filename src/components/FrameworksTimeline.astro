---
/** Annual timeline of framework origins, stewardship and integration, 2007–2026.
 * Logos are official assets served locally; bar labels describe maintainers or states.
 * Primary sources are linked in the accompanying article.
 */
interface Phase {
  /** Inclusive start year. */
  from: number;
  /** Inclusive end year. */
  to: number;
  /** Who held the project during this period. */
  who: string;
  where?: string;
  status?: string;
  /** Paragraph shown in the detail panel. */
  body: string;
  /** Dated facts, rendered as a list. */
  milestones?: string[];
}

interface Framework {
  name: string;
  type: string;
  color: string;
  /** Local logo filename. */
  mark: string | null;
  /** Panel paragraph when the whole row is selected. */
  summary: string;
  origin: string;
  phases: Phase[];
}

const START = 2007;
const END = 2026;
const years = Array.from({ length: END - START + 1 }, (_, i) => START + i);
/** Keep CSS tracks in sync with the timeline bounds. */
const YEAR_COUNT = years.length;

const frameworks: Framework[] = [
  {
    "name": "Theano y derivados",
    "type": "Compilador simbólico",
    "color": "#6d4fa3",
    "mark": "theano.png",
    "origin": "Montréal / MILA → Aesara → PyTensor (PyMC)",
    "summary": "El Theano original dejó el desarrollo principal en 2017. Su linaje continúa en forks: Theano-PyMC en 2020, Aesara en 2021 y PyTensor desde noviembre de 2022. En 2026 PyTensor sigue activo en el ecosistema PyMC; eso no reactiva el proyecto original.",
    "phases": [
      {
        "from": 2007,
        "to": 2017,
        "who": "Université de Montréal / MILA",
        "body": "El mismo entorno académico sostuvo Theano. No se representa una transferencia a MILA en 2013: no hay una fecha documentada que justifique esa frontera.",
        "milestones": [
          "2007 — inicio del proyecto",
          "28 de septiembre de 2017 — anuncio del fin del desarrollo principal",
          "15 de noviembre de 2017 — Theano 1.0"
        ]
      },
      {
        "from": 2018,
        "to": 2020,
        "who": "Mantenimiento limitado",
        "body": "El fin del desarrollo principal no significó que desapareciera el código: hubo versiones de mantenimiento y después continuaciones de la comunidad.",
        "milestones": [
          "Septiembre de 2018 — Theano 1.0.3",
          "2020 — Theano 1.0.5"
        ],
        "status": "Desarrollo principal detenido"
      },
      {
        "from": 2021,
        "to": 2021,
        "who": "Derivado: Aesara",
        "body": "PyMC creó un fork de Theano en 2020 y lo renombró Aesara en 2021. Esta barra sigue el linaje, no una transferencia de propiedad ni una nueva versión del Theano original.",
        "milestones": [
          "2020 — fork Theano-PyMC",
          "2021 — cambio de nombre a Aesara"
        ],
        "status": "Fork"
      },
      {
        "from": 2022,
        "to": 2026,
        "who": "Derivado: PyTensor · PyMC",
        "body": "PyMC anunció el fork de Aesara llamado PyTensor el 28 de noviembre de 2022. La continuación está orientada a computación simbólica y al ecosistema probabilístico de PyMC. Aesara no desapareció por el mero hecho de ese fork.",
        "milestones": [
          "28 de noviembre de 2022 — anuncio de PyTensor",
          "11 de mayo de 2026 — anuncio de PyMC 6.0 y PyTensor 3.0",
          "2 de octubre de 2026 — PyTensor 3.3.3"
        ],
        "status": "Derivado activo"
      }
    ]
  },
  {
    "name": "Caffe / Caffe2",
    "type": "Visión y producción",
    "color": "#2f6ba8",
    "mark": "caffe2.svg",
    "origin": "BVLC (Caffe) · Facebook (Caffe2)",
    "summary": "Caffe y Caffe2 son proyectos relacionados. Caffe 1.0 pasó a modo de mantenimiento en 2017. Caffe2 se integró con PyTorch en 2018; en mayo de 2024 se eliminó su código Python del repositorio. En 2026 no debe interpretarse la integración como soporte de la antigua API.",
    "phases": [
      {
        "from": 2007,
        "to": 2012,
        "who": "Sin proyecto",
        "body": "El proyecto todavía no se había publicado.",
        "milestones": [],
        "status": "Sin proyecto"
      },
      {
        "from": 2013,
        "to": 2016,
        "who": "BVLC · Caffe",
        "body": "Caffe fue desarrollado por Yangqing Jia en Berkeley y por la comunidad de BVLC. Sus archivos de configuración facilitaron compartir arquitecturas y pesos.",
        "milestones": [
          "2013 — publicación de Caffe"
        ]
      },
      {
        "from": 2017,
        "to": 2017,
        "who": "Facebook · Caffe2",
        "body": "Facebook presentó Caffe2 como un framework orientado al despliegue, con soporte móvil y entrenamiento distribuido.",
        "milestones": [
          "18 de abril de 2017 — presentación de Caffe2"
        ]
      },
      {
        "from": 2018,
        "to": 2023,
        "who": "Integrado en PyTorch",
        "body": "La integración reunió las capacidades de investigación de PyTorch y las de producción de Caffe2. La fila continúa para mostrar esa integración, no la desaparición del proyecto.",
        "milestones": [
          "2 de mayo de 2018 — anuncio conjunto de PyTorch 1.0"
        ],
        "status": "Integrado"
      },
      {
        "from": 2024,
        "to": 2026,
        "who": "Caffe2: Python retirado",
        "body": "El 15 de mayo de 2024 PyTorch incorporó la eliminación del código Python de Caffe2. Esto no afirma que se eliminara toda su herencia en C++. Caffe original es una rama separada: su última release publicada sigue siendo 1.0, de 2017, que anunció el paso a mantenimiento.",
        "milestones": [
          "15 de mayo de 2024 — eliminación del código Python de Caffe2",
          "2026 — Caffe 1.0 sigue siendo su última release publicada"
        ],
        "status": "Legado"
      }
    ]
  },
  {
    "name": "PyTorch",
    "type": "Grafo dinámico",
    "color": "#c2472f",
    "mark": "pytorch.svg",
    "origin": "Facebook AI Research → PyTorch Foundation (2022)",
    "summary": "PyTorch nació en Facebook AI Research, se publicó en 2017 y pasó a la PyTorch Foundation en 2022. Sigue activo en 2026, con aportaciones de varias empresas y de la comunidad. PyTorch 2.0 incorporó torch.compile en 2023.",
    "phases": [
      {
        "from": 2007,
        "to": 2016,
        "who": "Sin proyecto",
        "body": "El proyecto todavía no se había publicado.",
        "milestones": [],
        "status": "Sin proyecto"
      },
      {
        "from": 2017,
        "to": 2021,
        "who": "Facebook / Meta · FAIR",
        "body": "PyTorch construye el grafo mientras se ejecuta el programa. La integración con Caffe2 en 2018 amplió su ruta de investigación a producción.",
        "milestones": [
          "Enero de 2017 — lanzamiento público",
          "2018 — integración con Caffe2",
          "2021 — Facebook adopta el nombre corporativo Meta"
        ]
      },
      {
        "from": 2022,
        "to": 2026,
        "who": "PyTorch Foundation",
        "body": "La fundación, bajo el paraguas de Linux Foundation, amplía la gobernanza más allá de Meta. Meta sigue participando. La versión 2.0 añadió compilación opcional; el framework conserva la experiencia de ejecución eager.",
        "milestones": [
          "12 de septiembre de 2022 — anuncio de PyTorch Foundation",
          "15 de marzo de 2023 — PyTorch 2.0 y torch.compile",
          "2 de septiembre de 2026 — PyTorch 2.14.0"
        ],
        "status": "Activo"
      }
    ]
  },
  {
    "name": "TensorFlow",
    "type": "Aprendizaje automático",
    "color": "#b8860b",
    "mark": "tensorflow.png",
    "origin": "Google y comunidad",
    "summary": "TensorFlow nació en Google y se publicó en 2015. Sigue activo en 2026 con contribuciones de Google y de la comunidad. La expansión de Keras a varios backends no representa una transferencia de TensorFlow ni el fin de su desarrollo.",
    "phases": [
      {
        "from": 2007,
        "to": 2014,
        "who": "Sin proyecto",
        "body": "El proyecto todavía no se había publicado.",
        "milestones": [],
        "status": "Sin proyecto"
      },
      {
        "from": 2015,
        "to": 2026,
        "who": "Google y comunidad",
        "body": "TensorFlow continúa publicando versiones en 2026. Keras 3 permite usar varios backends y no equivale al abandono de TensorFlow. Al corte de esta revisión, 2.21.0 es la versión estable verificada y 2.22.0-rc0 es una candidata, no una release estable.",
        "milestones": [
          "9 de noviembre de 2015 — publicación de TensorFlow",
          "2017 — TensorFlow 1.0",
          "2019 — TensorFlow 2.0 y ejecución eager por defecto",
          "6 de marzo de 2026 — TensorFlow 2.21.0 estable",
          "24 de septiembre de 2026 — 2.22.0-rc0, versión candidata"
        ],
        "status": "Activo"
      }
    ]
  },
  {
    "name": "MXNet",
    "type": "Framework distribuido",
    "color": "#2f7f8f",
    "mark": "mxnet.png",
    "origin": "DMLC → Apache Incubator → Apache → Attic",
    "summary": "MXNet entró al Apache Incubator en 2017, se graduó en septiembre de 2022 y se retiró en septiembre de 2023. El traslado al Attic concluyó en febrero de 2024. En 2026 es un proyecto retirado con recursos conservados como archivo.",
    "phases": [
      {
        "from": 2007,
        "to": 2014,
        "who": "Sin proyecto",
        "body": "El proyecto todavía no se había publicado.",
        "milestones": [],
        "status": "Sin proyecto"
      },
      {
        "from": 2015,
        "to": 2016,
        "who": "Comunidad DMLC",
        "body": "MXNet surgió de una comunidad de investigadores de varias instituciones. El apoyo de AWS no equivalía a la propiedad del proyecto.",
        "milestones": [
          "2015 — publicación de MXNet",
          "2016 — AWS anuncia su respaldo"
        ]
      },
      {
        "from": 2017,
        "to": 2021,
        "who": "Apache Incubator",
        "body": "Apache proporciona el marco de incubación; AWS es patrocinador y contribuyente. El proyecto permaneció en incubación hasta septiembre de 2022.",
        "milestones": [
          "Enero de 2017 — entrada al Apache Incubator"
        ]
      },
      {
        "from": 2022,
        "to": 2022,
        "who": "Apache · TLP",
        "body": "MXNet se graduó como proyecto de primer nivel de Apache en septiembre de 2022. La celda anual muestra el estado alcanzado ese año, no doce meses completos como TLP.",
        "milestones": [
          "Septiembre de 2022 — graduación como Top Level Project"
        ],
        "status": "Graduado"
      },
      {
        "from": 2023,
        "to": 2026,
        "who": "Retirado · Apache Attic",
        "body": "Apache retiró MXNet en septiembre de 2023. El proceso administrativo de traslado al Attic terminó en febrero de 2024. El código y la documentación se conservan como recursos de consulta.",
        "milestones": [
          "Septiembre de 2023 — retiro",
          "Febrero de 2024 — traslado al Attic completado"
        ],
        "status": "Retirado"
      }
    ]
  }
];

const totalPhases = frameworks.reduce((sum, framework) => sum + framework.phases.length, 0);
const isGap = (phase: Phase) => phase.who === 'Sin proyecto' || phase.who === 'Solo investigación';
---

<section id="grafica" class="frameworks-timeline" aria-labelledby="ft-title" data-ft>
  <header class="ft-head">
    <p class="micro-label text-signal-deep">Quién mantiene cada framework · 2007–2026</p>
    <h2 id="ft-title" class="ft-headline">
      Universidades, empresas y comunidades: cinco trayectorias distintas.
    </h2>
    <p class="ft-lede">
      Cada fila representa un framework o una familia de proyectos. Las barras indican responsables o estados. Haz clic en una
      barra —o en el nombre— para leer qué pasó, dónde y cuándo. Mueve el año para ver el reparto de un
      momento concreto.
    </p>
  </header>

  <div class="ft-controls">
    <div class="ft-year">
      <label for="ft-range" class="micro-label">Año</label>
      <output id="ft-year" class="ft-year-value" for="ft-range">Todo</output>
      <input
        id="ft-range"
        class="ft-range"
        type="range"
        min={START}
        max={END}
        step="1"
        value={END}
        aria-describedby="ft-year-hint"
      />
    </div>
    <p id="ft-year-hint" class="ft-hint micro-label">
      {totalPhases} etapas · arrastra para recorrer la línea de tiempo
    </p>
    <button type="button" class="ft-reset micro-label" data-ft-reset>Ver todo</button>
  </div>

  <div class="ft-scroll" tabindex="0" role="region" aria-label="Línea de tiempo desplazable">
    <div
      class="ft-grid"
      role="group"
      aria-label="Cronología de frameworks de deep learning, 2007 a 2026"
      style={`--ft-years:${YEAR_COUNT}`}
      data-ft-grid
    >
      <div class="ft-corner" aria-hidden="true"><span class="micro-label">Framework</span></div>
      {
        years.map((year) => (
          <div class="ft-year-head" data-ft-col={year} aria-hidden="true">
            <span>{year}</span>
          </div>
        ))
      }

      {
        frameworks.map((framework, rowIndex) => {
          const gridRow = rowIndex + 2;
          return (
            <>
              <div class="ft-rowlabel" style={`grid-row:${gridRow}`}>
                <button
                  type="button"
                  class="ft-rowbtn"
                  data-ft-row={rowIndex}
                  aria-pressed="false"
                  style={`--row-color:${framework.color}`}
                >
                  <span class="ft-rowmark"><img src={`/images/frameworks/${framework.mark}`} width="28" height="28" alt="" /></span>
                  <span class="ft-rowtext">
                    <span class="ft-rowname">{framework.name}</span>
                    <span class="ft-rowtype">{framework.type}</span>
                  </span>
                </button>
              </div>

              {framework.phases.map((phase, phaseIndex) => {
                const from = Math.max(phase.from, START);
                const to = Math.min(phase.to, END);
                const cols = Math.max(1, to - from + 1);
                const empty = isGap(phase);
                return (
                  <button
                    type="button"
                    class="ft-span"
                    data-ft-row={rowIndex}
                    data-ft-phase={phaseIndex}
                    data-ft-cols={cols}
                    aria-pressed="false"
                    aria-label={`${framework.name}, ${phase.from} a ${phase.to}: ${phase.who}`}
                    style={{
                      gridRow,
                      gridColumn: `${from - START + 2} / span ${cols}`,
                      '--phase-color': framework.color,
                      '--phase-ink': `color-mix(in srgb, ${framework.color} 58%, var(--color-ink))`,
                      '--phase-tint': `color-mix(in srgb, ${framework.color} 22%, var(--color-sheet))`,
                    }}
                    data-empty={empty ? 'true' : 'false'}
                    data-tight={cols <= 2 ? 'true' : 'false'}
                  >
                    <span class="ft-span-inner">
                      <span class="ft-spanwho">{phase.who}</span>
                    </span>
                  </button>
                );
              })}
            </>
          );
        })
      }
    </div>
  </div>

  <p class="ft-note">
    Los cuadros punteados preceden al lanzamiento público. Los colores identifican frameworks; las etiquetas indican responsables o estados. Cada año muestra el estado alcanzado al cierre; 2026 se corta al 4 de octubre. Los cambios dentro de un año se detallan en el panel. Theano incluye derivados, no la reactivación del original. La fila Caffe / Caffe2 reúne proyectos relacionados y usa el logo de Caffe2.
  </p>

  <div class="ft-detail" data-ft-detail aria-live="polite"></div>

  <ol class="ft-index">
    {
      frameworks.map((framework, rowIndex) => (
        <li>
          <button
            type="button"
            class="ft-indexbtn"
            data-ft-row={rowIndex}
            style={`--row-color:${framework.color}`}
          >
            <span class="ft-indexdot" aria-hidden="true" />
            <span class="ft-indexname">{framework.name}</span>
            <span class="ft-indextype">{framework.origin}</span>
          </button>
        </li>
      ))
    }
  </ol>
</section>

<script is:inline define:vars={{ frameworks }}>
  window.__FT_DATA__ = { frameworks };
</script>

<script>
  interface Phase {
    from: number;
    to: number;
    who: string;
    where?: string;
    status?: string;
    body: string;
    milestones?: string[];
  }

  interface Framework {
    name: string;
    type: string;
    color: string;
    mark: string | null;
    summary: string;
    origin: string;
    phases: Phase[];
  }

  const START = 2007;
  const END = 2026;
  const YEARS = Array.from({ length: END - START + 1 }, (_, i) => START + i);

  const payload = (window as unknown as { __FT_DATA__?: { frameworks: Framework[] } }).__FT_DATA__;
  const FRAMEWORKS: Framework[] = payload?.frameworks ?? [];

  /**
   * Astro scopes this component's CSS with a `data-astro-cid-*` attribute on every
   * element it renders at build time. Markup injected later by this script carries
   * none of those attributes, so every rule for the detail panel would silently
   * fail to match. The scope is read off the rendered root and stamped onto each
   * generated node.
   */
  const scopeOf = (root: HTMLElement) =>
    Array.from(root.attributes).find((attr) => attr.name.startsWith('data-astro-cid-'))?.name ?? '';
  /** Set per instance in `mount`; empty is survivable — it only costs panel styling. */
  let CID = '';

  const inSpan = (phase: Phase, year: number) => year >= phase.from && year <= phase.to;
  const spanLabel = (phase: Phase) =>
    phase.from === phase.to ? String(phase.from) : `${phase.from}–${phase.to}`;
  const isGap = (phase: Phase) => phase.who === 'Sin proyecto' || phase.who === 'Solo investigación';

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string,
    );

  /**
   * Panel markup is authored with `data-cid` placeholders and the scope is
   * substituted in once per render. Values that go into the markup are escaped
   * first (which neutralises any `@` in the data), so a plain substitution is
   * safe here.
   */
  const html = (template: string) => template.replaceAll(' data-cid', CID);
  const text = (value: string) => escapeHtml(value).replaceAll('@', '&#64;');

  /** Inline custom properties so each card inherits its framework's colours. */
  const palette = (framework: Framework) =>
    `--phase-color:${framework.color};--phase-ink:color-mix(in srgb, ${framework.color} 58%, var(--color-ink));--phase-tint:color-mix(in srgb, ${framework.color} 22%, var(--color-sheet))`;

  const positionBar = (from: number, to: number) => {
    const a = ((Math.max(from, START) - START) / (END - START + 1)) * 100;
    const b = ((Math.min(to, END) - START + 1) / (END - START + 1)) * 100;
    return `left:${a.toFixed(3)}%;right:${Math.max(0, 100 - b).toFixed(3)}%`;
  };

  const panelForPhase = (framework: Framework, phase: Phase, year: number | null) => {
    const facts = (phase.milestones ?? []).map((item) => `<li data-cid>${text(item)}</li>`).join('');
    const now =
      year === null
        ? ''
        : inSpan(phase, year)
          ? `En ${year} esta etapa está activa`
          : year < phase.from
            ? `En ${year} esta etapa todavía no empieza`
            : `En ${year} esta etapa ya había terminado`;
    return html(`
      <div class="ft-card" data-cid style="${palette(framework)}">
        <p class="ft-card-kicker micro-label" data-cid>${text(framework.name)} · ${text(spanLabel(phase))}</p>
        <h3 class="ft-card-title" data-cid>${text(phase.who)}</h3>
        <p class="ft-card-org micro-label" data-cid>${text(phase.where ?? framework.origin)}${
          phase.status && phase.status !== phase.who ? ` · ${text(phase.status)}` : ''
        }</p>
        <p class="ft-card-body" data-cid>${text(phase.body)}</p>
        ${facts ? `<ul class="ft-card-facts" data-cid>${facts}</ul>` : ''}
        ${now ? `<p class="ft-card-now micro-label" data-cid>${text(now)}</p>` : ''}
      </div>`);
  };

  const panelForRow = (framework: Framework, year: number | null) => {
    const tracks = framework.phases
      .map((phase) => {
        const state =
          year === null
            ? 'Etapa'
            : inSpan(phase, year)
              ? 'En este año'
              : year < phase.from
                ? 'Todavía no'
                : 'Terminado';
        const fill =
          state === 'Terminado'
            ? `color-mix(in srgb, ${framework.color} 30%, var(--color-sheet))`
            : framework.color;
        return `
          <li class="ft-track" data-cid data-state="${state === 'En este año' ? 'on' : 'off'}">
            <span class="ft-track-bar" data-cid style="${positionBar(phase.from, phase.to)};background:${fill}"></span>
            <span class="ft-track-years micro-label" data-cid>${text(spanLabel(phase))}</span>
            <span class="ft-track-state micro-label" data-cid>${state}</span>
            <span class="ft-track-who" data-cid>${text(phase.who)}${
              phase.where ? ` <span class="ft-track-where" data-cid>· ${text(phase.where)}</span>` : ''
            }</span>
          </li>`;
      })
      .join('');
    return html(`
      <div class="ft-card" data-cid style="${palette(framework)}">
        <p class="ft-card-kicker micro-label" data-cid>${text(framework.name)} · ${text(framework.type)}</p>
        <h3 class="ft-card-title" data-cid>${text(framework.origin)}</h3>
        <p class="ft-card-body" data-cid>${text(framework.summary)}</p>
        <ol class="ft-tracks" data-cid>${tracks}</ol>
        <p class="ft-card-now micro-label" data-cid>Haz clic en una barra de la gráfica para leer cada etapa</p>
      </div>`);
  };

  const panelForYear = (year: number) => {
    const rows = FRAMEWORKS.map((framework) => {
      const active = framework.phases.find((phase) => inSpan(phase, year) && !isGap(phase));
      return `
        <li class="ft-yearrow" data-cid>
          <span class="ft-yeardot" data-cid style="background:${active ? framework.color : 'transparent'};border-color:${
            active ? framework.color : 'var(--color-hairline)'
          }"></span>
          <span class="ft-yearname" data-cid>${text(framework.name)}</span>
          <span class="ft-yearwho" data-cid>${text(active ? active.who : 'Sin proyecto todavía')}</span>
        </li>`;
    }).join('');
    return html(`
      <div class="ft-card ft-card--year" data-cid>
        <p class="ft-card-kicker micro-label" data-cid>Estado del ecosistema</p>
        <h3 class="ft-card-title" data-cid>${year}</h3>
        <p class="ft-card-body" data-cid>Quién mantenía cada framework en ${year}. Elige una fila o una barra para leer la explicación completa.</p>
        <ul class="ft-yearlist" data-cid>${rows}</ul>
      </div>`);
  };

  function mount(root: HTMLElement) {
    const grid = root.querySelector<HTMLElement>('[data-ft-grid]');
    const detail = root.querySelector<HTMLElement>('[data-ft-detail]');
    const range = root.querySelector<HTMLInputElement>('#ft-range');
    const yearOut = root.querySelector<HTMLElement>('#ft-year');
    const hint = root.querySelector<HTMLElement>('#ft-year-hint');
    const reset = root.querySelector<HTMLButtonElement>('[data-ft-reset]');
    if (!grid || !detail || !range || !yearOut || !reset || FRAMEWORKS.length === 0) return;

    // Bound before the first render so the year panel is styled on load.
    const scope = scopeOf(root);
    CID = scope ? ` ${scope}` : '';

    let year: number | null = null;
    let selectedRow: number | null = null;
    let selectedPhase: number | null = null;

    const rowButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.ft-rowbtn'));
    const indexButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.ft-indexbtn'));
    const spans = Array.from(root.querySelectorAll<HTMLButtonElement>('.ft-span'));
    const heads = Array.from(root.querySelectorAll<HTMLElement>('[data-ft-col]'));

    const render = () => {
      heads.forEach((head) => {
        const column = Number(head.dataset.ftCol);
        head.classList.toggle('is-year', year !== null && column === year);
        head.classList.toggle('is-past', year !== null && column < year);
      });

      grid.classList.toggle('is-scrubbing', year !== null);
      if (year !== null) grid.style.setProperty('--ft-year-index', String(year - START));

      const rowSelected = selectedRow !== null && selectedPhase === null;
      rowButtons.forEach((button) =>
        button.classList.toggle('is-active', rowSelected && Number(button.dataset.ftRow) === selectedRow),
      );
      indexButtons.forEach((button) =>
        button.classList.toggle('is-active', rowSelected && Number(button.dataset.ftRow) === selectedRow),
      );

      spans.forEach((span) => {
        const isSelected =
          selectedPhase !== null &&
          Number(span.dataset.ftRow) === selectedRow &&
          Number(span.dataset.ftPhase) === selectedPhase;
        span.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });

      grid.classList.toggle('has-selection', selectedPhase !== null);
      [...rowButtons, ...indexButtons].forEach((button) => button.setAttribute('aria-pressed', String(rowSelected && Number(button.dataset.ftRow) === selectedRow)));

      if (selectedRow !== null && selectedPhase !== null) {
        detail.innerHTML = panelForPhase(
          FRAMEWORKS[selectedRow],
          FRAMEWORKS[selectedRow].phases[selectedPhase],
          year,
        );
      } else if (selectedRow !== null) {
        detail.innerHTML = panelForRow(FRAMEWORKS[selectedRow], year);
      } else {
        detail.innerHTML = panelForYear(year ?? END);
      }
    };

    const revealPanel = () => {
      if (window.matchMedia('(max-width: 1023px)').matches) {
        detail.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'nearest' });
      }
    };

    const selectPhase = (row: number, phase: number) => {
      if (selectedRow === row && selectedPhase === phase) {
        selectedPhase = null;
      } else {
        selectedRow = row;
        selectedPhase = phase;
      }
      render();
      revealPanel();
    };

    const selectRow = (row: number) => {
      if (selectedRow === row && selectedPhase === null) {
        selectedRow = null;
      } else {
        selectedRow = row;
        selectedPhase = null;
      }
      render();
      revealPanel();
    };

    spans.forEach((span) =>
      span.addEventListener('click', () =>
        selectPhase(Number(span.dataset.ftRow), Number(span.dataset.ftPhase)),
      ),
    );
    rowButtons.forEach((button) =>
      button.addEventListener('click', () => selectRow(Number(button.dataset.ftRow))),
    );
    indexButtons.forEach((button) =>
      button.addEventListener('click', () => selectRow(Number(button.dataset.ftRow))),
    );

    const syncYear = () => {
      year = Number(range.value);
      yearOut.textContent = String(year);
      if (hint) hint.textContent = `Viendo ${year} · año ${year - START + 1} de ${YEARS.length}`;
      render();
    };

    range.addEventListener('input', syncYear);
    reset.addEventListener('click', () => {
      year = null;
      selectedRow = null;
      selectedPhase = null;
      range.value = String(END);
      yearOut.textContent = 'Todo';
      if (hint) hint.textContent = 'Arrastra para recorrer la línea de tiempo';
      render();
    });

    render();
  }

  document.querySelectorAll<HTMLElement>('[data-ft]').forEach(mount);
</script>

