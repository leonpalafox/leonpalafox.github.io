---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import VibeNav from '../../../components/VibeNav.astro';
import VibePrompt from '../../../components/VibePrompt.astro';
import '../../../styles/vibe-coding.css';
import {
  BANS,
  DEFAULT_SPEC,
  ENGINES,
  PROMPT_TREE_START,
  STYLE_LINES,
  TASKS,
  buildSetupPrompt,
  flattenTree,
} from '../../../data/vibe-coding';

const setup = buildSetupPrompt(DEFAULT_SPEC);
const blanks = (setup.match(/<[^>\n]+>/g) ?? []).length;
const tree = flattenTree();
const startNode = tree.find((node) => node.key === PROMPT_TREE_START)!;
---

<Base
  title="Data Science Prompt Builder — León Palafox"
  description="Fill in your environment, data, model and metric, and get a setup prompt for an AI assistant with the eight rules of data science vibe coding built in."
>
  <PageHero
    eyebrow="Vibe coding · prompt builder"
    jp="仕様"
    title="Build the setup prompt"
    description="The first message of a project carries the rules and asks for no code. Fill in what you know. Whatever you leave blank stays in the prompt as a marked gap, so you can see what the assistant would have had to guess."
  />
  <VibeNav />

  <section class="border-b border-hairline px-6 py-12 sm:px-10 lg:px-14">
    <div class="grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
      <form data-vc-builder autocomplete="off" class="min-w-0">
        <fieldset class="vc-fieldset !border-t-0 !pt-0">
          <legend><span class="micro-label text-signal-deep">The task</span></legend>
          <label class="vc-field">
            <span class="vc-field__label">What you are building</span>
            <input class="vc-input" type="text" name="goal" placeholder="a model that predicts … from …" />
            <span class="vc-field__help">Completes the sentence “You will help me build …”.</span>
          </label>
          <label class="vc-field">
            <span class="vc-field__label">Kind of problem</span>
            <select class="vc-input" name="task">
              {TASKS.map((task) => <option value={task.id} selected={task.id === DEFAULT_SPEC.task}>{task.label}</option>)}
            </select>
            <span class="vc-field__help">Sets how the data is split, the default score and the baseline.</span>
          </label>
        </fieldset>

        <fieldset class="vc-fieldset">
          <legend><span class="micro-label text-signal-deep">Rule 01 · Environment</span></legend>
          <div class="vc-field">
            <span class="vc-field__label">Where the code runs</span>
            <div class="mt-2 grid gap-1">
              {
                ENGINES.map((engine) => (
                  <label class="vc-check">
                    <input type="radio" name="engine" value={engine.id} checked={engine.id === DEFAULT_SPEC.engine} />
                    <span>
                      {engine.label}
                      <span class="block text-xs text-muted">{engine.what}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </div>
          <label class="vc-field">
            <span class="vc-field__label">Project folder</span>
            <input class="vc-input vc-input--mono" type="text" name="project" value={DEFAULT_SPEC.project} />
          </label>
          <label class="vc-check" data-only-local hidden>
            <input type="checkbox" name="structure" checked={DEFAULT_SPEC.structure} />
            <span>
              Fix the file tree in the prompt
              <span class="block text-xs text-muted">On a laptop the prompt also decides where every file goes.</span>
            </span>
          </label>
        </fieldset>

        <fieldset class="vc-fieldset">
          <legend><span class="micro-label text-signal-deep">Rule 02 · Data contract</span></legend>
          <label class="vc-field">
            <span class="vc-field__label">Source</span>
            <input class="vc-input vc-input--mono" type="text" name="source" placeholder="https://…/data.csv" />
          </label>
          <div class="grid grid-cols-2 gap-4">
            <label class="vc-field">
              <span class="vc-field__label">Rows</span>
              <input class="vc-input" type="text" inputmode="numeric" name="rows" placeholder="12,400" />
            </label>
            <label class="vc-field">
              <span class="vc-field__label">Columns</span>
              <input class="vc-input" type="text" inputmode="numeric" name="cols" placeholder="18" />
            </label>
          </div>
          <div class="grid gap-x-4 sm:grid-cols-2">
            <label class="vc-field">
              <span class="vc-field__label">Target column</span>
              <input class="vc-input vc-input--mono" type="text" name="target" placeholder="column_name" />
            </label>
            <label class="vc-field">
              <span class="vc-field__label">Its values</span>
              <input class="vc-input" type="text" name="targetNote" placeholder="yes/no, convert to 1/0" />
            </label>
          </div>
          <label class="vc-field">
            <span class="vc-field__label">Columns the assistant would misread</span>
            <textarea
              class="vc-input"
              name="columnNotes"
              rows="3"
              placeholder={'"zip_code" is a code, not a quantity: treat it as categorical.\n"closed_at" is only known after the outcome: drop it.'}
            ></textarea>
            <span class="vc-field__help">One per line: codes that look like numbers, dates stored as text, columns filled in after the outcome.</span>
          </label>
        </fieldset>

        <fieldset class="vc-fieldset">
          <legend><span class="micro-label text-signal-deep">Rule 03 · Model and search space</span></legend>
          <label class="vc-field">
            <span class="vc-field__label">Models allowed</span>
            <input
              class="vc-input"
              type="text"
              name="models"
              placeholder="scikit-learn DecisionTreeClassifier and RandomForestClassifier"
            />
          </label>
          <label class="vc-field">
            <span class="vc-field__label">Search space</span>
            <textarea
              class="vc-input"
              name="grid"
              rows="3"
              placeholder={'max_depth: [2, 3, 4, 5, 6, 8, 10, 12]\nmin_samples_leaf: [1, 5, 10, 20]'}
            ></textarea>
            <span class="vc-field__help">One parameter per line. Leave it empty if you tune in a later step.</span>
          </label>
          <div class="vc-field">
            <span class="vc-field__label">Off the table</span>
            <div class="mt-2 grid gap-0.5">
              {
                BANS.map((ban) => (
                  <label class="vc-check">
                    <input type="checkbox" name="bans" value={ban.id} checked={DEFAULT_SPEC.bans.includes(ban.id)} />
                    <span>{ban.label}</span>
                  </label>
                ))
              }
            </div>
          </div>
          <label class="vc-field max-w-[10rem]">
            <span class="vc-field__label">Random seed</span>
            <input class="vc-input vc-input--mono" type="number" name="seed" min="0" max="999999" value={DEFAULT_SPEC.seed} />
          </label>
        </fieldset>

        <fieldset class="vc-fieldset">
          <legend><span class="micro-label text-signal-deep">Rules 04–05 · Validation</span></legend>
          <div class="grid grid-cols-2 gap-4">
            <label class="vc-field">
              <span class="vc-field__label">Test set, %</span>
              <input class="vc-input vc-input--mono" type="number" name="testPct" min="5" max="50" value={DEFAULT_SPEC.testPct} />
            </label>
            <label class="vc-field">
              <span class="vc-field__label">CV folds</span>
              <input class="vc-input vc-input--mono" type="number" name="folds" min="2" max="20" value={DEFAULT_SPEC.folds} />
            </label>
          </div>
          <label class="vc-field">
            <span class="vc-field__label">Score to tune on</span>
            <input class="vc-input vc-input--mono" type="text" name="score" value={DEFAULT_SPEC.score} />
            <span class="vc-field__help">A scikit-learn scoring name. It changes with the kind of problem until you edit it.</span>
          </label>
          <label class="vc-field" data-only-task="binary">
            <span class="vc-field__label">Threshold rule</span>
            <input
              class="vc-input"
              type="text"
              name="threshold"
              placeholder="the highest threshold that keeps recall at or above 0.80"
            />
            <span class="vc-field__help">Optional. The prompt already says the threshold comes from out-of-fold predictions.</span>
          </label>
        </fieldset>

        <fieldset class="vc-fieldset">
          <legend><span class="micro-label text-signal-deep">Rule 06 · Success</span></legend>
          <label class="vc-field">
            <span class="vc-field__label">The goal, in business terms</span>
            <input class="vc-input" type="text" name="outcome" placeholder="catch the cases that matter, even with some false alarms" />
          </label>
          <label class="vc-field">
            <span class="vc-field__label">Metrics to report</span>
            <input class="vc-input" type="text" name="metrics" value={DEFAULT_SPEC.metrics} />
          </label>
          <p class="mb-4 text-sm leading-relaxed text-muted">
            Baseline to beat: <span class="text-ink" data-baseline>{TASKS[0].baseline}</span>.
          </p>
        </fieldset>

        <fieldset class="vc-fieldset">
          <legend><span class="micro-label text-signal-deep">Rules 07–08 · Working style</span></legend>
          <div class="grid gap-0.5">
            {
              STYLE_LINES.map((line) => (
                <label class="vc-check">
                  <input type="checkbox" name="style" value={line.id} checked={DEFAULT_SPEC.style.includes(line.id)} />
                  <span>{line.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </form>

      <div class="min-w-0 lg:sticky lg:top-6 lg:self-start">
        <div class="lg:max-h-[calc(100vh-9rem)] lg:overflow-y-auto">
          <VibePrompt tone="spec" label="Prompt 0 · Setup" name="setup" text={setup} />
        </div>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-muted" data-vc-blanks aria-live="polite">{blanks} blanks left to fill.</p>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="vc-button" data-vc-download hidden>Save as 00_setup.md</button>
            <button type="button" class="vc-button" data-vc-reset>Reset</button>
          </div>
        </div>
        <noscript>
          <p class="mt-4 border border-hairline bg-paper p-4 text-sm text-muted">
            The form needs JavaScript to update the prompt. Without it, the text above is the template: replace
            everything in angle brackets by hand.
          </p>
        </noscript>
        <p class="mt-4 text-xs leading-relaxed text-muted">
          What you type stays in this browser. Nothing is sent anywhere.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-hairline px-6 py-14 sm:px-10 lg:px-14">
    <SectionHeading title="How to send it" />
    <div class="mt-8 grid gap-10 lg:grid-cols-3">
      <div>
        <p class="micro-label text-signal-deep">First message, no code</p>
        <p class="mt-3 text-sm leading-relaxed">
          Send the setup prompt on its own. The reply should restate the constraints, propose a step plan and ask its
          questions. If it comes back with code, the working-style rules did not land. Say so before going further.
        </p>
      </div>
      <div>
        <p class="micro-label text-signal-deep">Then one step per message</p>
        <p class="mt-3 text-sm leading-relaxed">
          Load and audit the data. Split and set the baseline. Tune inside train. Open the test set once. Explain the
          result. Each step is a short prompt of its own, and each answer gets checked before the next one goes out.
        </p>
      </div>
      <div>
        <p class="micro-label text-signal-deep">Same prompt, another tool</p>
        <p class="mt-3 text-sm leading-relaxed">
          To move from Colab to a laptop, change the environment and nothing else. If two tools give very different
          numbers from the same spec, one of them broke a rule. The
          <a href="/teaching/vibe-coding/review/" class="underline underline-offset-4 hover:text-signal-deep">checklist</a>
          will tell you which.
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 py-14 sm:px-10 lg:px-14">
    <SectionHeading title="Prompts live in a folder" />
    <p class="mt-6 max-w-2xl text-[1.05rem] leading-relaxed">
      A prompt that only exists in a chat history cannot be rerun, compared or fixed. Keep one file per prompt, give
      each a version, assemble the final text from parts and log every run. Click through the folder to see what goes
      in each file.
    </p>
    <div class="vc-widget mt-8 grid lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]" data-vc-tree>
      <ul class="vc-tree border-b border-hairline py-2 lg:border-b-0 lg:border-r">
        {
          tree.map((node) => (
            <li>
              <button
                type="button"
                data-key={node.key}
                data-dir={String(node.isDir)}
                aria-pressed={node.key === PROMPT_TREE_START ? 'true' : 'false'}
                style={`--depth: ${node.depth}`}
              >
                <span>{node.name}</span>
                {node.note && <span class="vc-tree__note">{node.note}</span>}
              </button>
            </li>
          ))
        }
      </ul>
      <div class="vc-tree__panel min-w-0 bg-sheet p-6" data-vc-tree-panel aria-live="polite">
        <p class="micro-label text-signal-deep">File</p>
        <h3 class="mt-2 font-mono text-lg">{startNode.key}</h3>
        <p class="mt-3 text-sm leading-relaxed">{startNode.what}</p>
        {startNode.pre && <pre tabindex="0">{startNode.pre}</pre>}
      </div>
    </div>

    <a href="/teaching/vibe-coding/" class="group micro-label mt-12 inline-flex items-center gap-2 text-signal-deep hover:text-signal">
      <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
      The eight rules
    </a>
  </section>
</Base>

<script>
  import { mountVibeCoding } from '../../../scripts/vibe-coding';

  mountVibeCoding();
</script>
