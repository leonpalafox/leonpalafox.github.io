---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MediaSpotlight from '../components/MediaSpotlight.astro';
import { getCollection } from 'astro:content';
import SectionHeading from '../components/SectionHeading.astro';
import { getAsset } from '../lib/assets';
import nvidiaHero from '../assets/nvidia-hero.jpg';
import mbnHero from '../assets/mbn-ai-hype-stage-2026.jpg';
import mitPhoto from '../assets/mit-top-business-leaders-2026.jpg';
import wiredHero from '../assets/wired-agentic-ai-2026.jpg';
import mitLogo from '../assets/logos/publications/mit-technology-review.png';
import wiredLogo from '../assets/logos/publications/wired.svg';
import financieroLogo from '../assets/logos/publications/el-financiero.png';
import forbesLogo from '../assets/logos/publications/forbes-mexico.svg';
import expansionLogo from '../assets/logos/publications/expansion.svg';
import nvidiaLogo from '../assets/logos/publications/nvidia.svg';
import mbnLogo from '../assets/logos/publications/mexico-business-news.svg';
import economistaLogo from '../assets/logos/publications/el-economista.png';
import tvAztecaLogo from '../assets/logos/publications/tv-azteca.png';

const publications = [
  { name: 'MIT Technology Review', logo: mitLogo, href: '#press', width: 250 },
  { name: 'WIRED', logo: wiredLogo, href: '#press', width: 135 },
  { name: 'El Financiero', logo: financieroLogo, href: '#columns', width: 190 },
  { name: 'Forbes México', logo: forbesLogo, href: '#press', width: 125 },
  { name: 'Expansión', logo: expansionLogo, href: '#press', width: 155 },
  {
    name: 'El Economista', logo: economistaLogo, width: 210,
    href: 'https://www.eleconomista.com.mx/sectorfinanciero/IA-plantea-oportunidades-y-retos-para-las-instituciones-financieras-20220908-0092.html',
  },
  {
    name: 'TV Azteca', logo: tvAztecaLogo, width: 170,
    href: 'https://www.tvazteca.com/aztecanoticias/cobro-tarjeta-terminal-cartera-autorizacion',
  },
];

const columns = [
  {
    year: '2025',
    items: [
      {
        title: 'Coatlicue: La soberanía digital de México requiere más que silicio',
        date: 'Dec 08',
        href: 'https://www.elfinanciero.com.mx/opinion/leon-palafox1/2025/12/08/coatlicue-la-soberania-digital-de-mexico-requiere-mas-que-silicio/',
      },
      {
        title: 'La verdadera ventaja de la IA: no son los modelos, son los chips',
        date: 'Aug 05',
        href: 'https://www.elfinanciero.com.mx/opinion/leon-palafox1/2025/08/05/la-verdadera-ventaja-de-la-ia-no-son-los-modelos-son-los-chips/',
      },
      {
        title: '¿Quién va a ganar la carrera de la IA? Aquellos que sepan usarla',
        date: 'Jul 23',
        href: 'https://www.elfinanciero.com.mx/opinion/leon-palafox/2025/07/23/quien-va-a-ganar-la-carrera-de-la-ia-aquellos-que-sepan-usarla/',
      },
    ],
  },
  {
    year: '2023–2024',
    items: [
      {
        title: '¿Qué pasó en el 2023 con los grandes modelos de lenguaje?',
        date: 'Dec 26',
        href: 'https://www.elfinanciero.com.mx/opinion/leon-palafox/2023/12/26/que-paso-en-el-2023-con-los-grandes-modelos-de-lenguaje/',
      },
      {
        title: 'El fin de semana que marcó el futuro de la IA en el mundo (OpenAI)',
        date: 'Dec 05',
        href: 'https://www.elfinanciero.com.mx/opinion/leon-palafox/2023/12/05/el-fin-de-semana-que-marco-el-futuro-de-la-ia-en-el-mundo/',
      },
      {
        title: 'La Historia de la IA, México, y su lugar en el mundo',
        date: 'Sep 19',
        href: 'https://www.elfinanciero.com.mx/opinion/leon-palafox/2023/09/19/la-historia-de-la-ia-mexico-y-su-lugar-en-el-mundo-fin-de-la-historia/',
      },
    ],
  },
];

const talks = [
  {
    outlet: 'Software Guru Data Day (2024)',
    title: 'Panel: Habilidades matemáticas en la era de la Ciencia de Datos',
    href: 'https://sg.com.mx/dataday/speakers/leon-palafox/',
  },
  {
    outlet: 'Reporte Asia Podcast',
    title: 'Sociedad 5.0 e Inteligencia Artificial',
    href: 'https://reporteasia.com/destacado/2023/05/05/podcast-sociedad-5-0-e-inteligencia-artificial-por-aqui-asia/',
  },
  {
    outlet: 'La Entrevista (Banco Cuscatlán)',
    title: 'La inteligencia artificial no es infalible',
    href: 'https://podcasts.apple.com/us/podcast/la-inteligencia-artificial-no-es-infalible/id1593431639',
  },
  {
    outlet: 'YouTube Talk',
    title: 'Impacto de las estrategias basadas en datos',
    href: 'https://www.youtube.com/watch?v=i3oR-HcV86U',
  },
];

const press = [
  {
    year: '2026',
    items: [
      {
        date: 'Sep 14',
        title: 'El negocio de la IA que ‘acabará con la humanidad’ ya genera empresas de más de 4,600 mdd',
        outlet: 'Expansión',
        href: 'https://expansion.mx/tecnologia/2026/09/14/ia-que-acabara-con-la-humanidad-genera-empresas-millonarias',
        note: 'Sobre la automejora recursiva como la vertical de negocio que hay detrás del debate existencial.',
      },
      {
        date: 'Oct',
        title: 'La burbuja de la IA',
        outlet: 'Expansión (revista) · pp. 40–41',
        href: 'https://embed-rech-01.dialog.cm/expansionpublishing/docs/expansi_n_octubre_2026_la_compra_de_la_d_cada',
        note: 'Reportaje en la edición de octubre de 2026.',
      },
    ],
  },
  {
    year: '2023',
    items: [
      {
        date: 'Jun 26',
        title: 'Imposible que la inteligencia artificial domine y destruya a los humanos',
        outlet: 'Diario Digital México',
        href: 'https://diariodigitalmexico.com/imposible-que-la-inteligencia-artificial-domine-y-destruya-a-los-humanos-leon-palafox/',
        note: 'Sobre por qué la IA no puede dominar ni destruir a la humanidad, y su impacto en el empleo.',
      },
      {
        date: 'Jun 26',
        title: 'Imposible que la inteligencia artificial destruya a los humanos: León Palafox',
        outlet: 'Emprefinanzas',
        href: 'https://emprefinanzas.com.mx/2023/06/26/imposible-que-la-inteligencia-artificial-destruya-a-los-humanos-leon-palafox/',
        note: 'Otra versión de la misma entrevista publicada por Diario Digital México.',
      },
      {
        date: 'Jun 29',
        title: '¿Es posible el cobro con tarjeta sin mi autorización?',
        outlet: 'TV Azteca',
        href: 'https://www.tvazteca.com/aztecanoticias/cobro-tarjeta-terminal-cartera-autorizacion',
        note: 'Sobre cobros con tarjeta sin autorización y la tecnología NFC.',
      },
      {
        date: 'Sep 14',
        title: 'Academia y gobierno, los eslabones débiles de la inteligencia artificial en México',
        outlet: 'Forbes México',
        href: 'https://forbes.com.mx/academia-y-gobierno-los-eslabones-debiles-de-la-inteligencia-artificial-en-mexico/',
        note: 'Sobre los pendientes de México en talento, política pública y adopción de IA.',
      },
      {
        date: 'Oct 24',
        title: '¿Puede México “subirse a la ola de IA”? 5 cosas que debe hacer',
        outlet: 'Arena Pública',
        href: 'https://www.arenapublica.com/tecnologias/puede-mexico-subirse-la-ola-de-ia-5-cosas-que-debe-hacer',
        note: 'Sobre talento, inversión y cultura de datos para subirse a la ola de la IA.',
      },
    ],
  },
  {
    year: '2022',
    items: [
      {
        date: 'Sep 08',
        title: 'IA plantea oportunidades y retos para las instituciones financieras',
        outlet: 'El Economista',
        href: 'https://www.eleconomista.com.mx/sectorfinanciero/IA-plantea-oportunidades-y-retos-para-las-instituciones-financieras-20220908-0092.html',
        note: 'Sobre oportunidades, retos y resultados tangibles de la IA en el sector financiero.',
      },
    ],
  },
];

const featured = [
  {
    outlet: 'MIT Technology Review',
    date: 'September 28, 2026',
    datetime: '2026-09-28',
    title: 'León Palafox: “El valor de la IA empieza por conectar con quienes conocen el negocio”',
    description: 'An interview for AI Top Business Leaders México on connecting AI with the people who know the business.',
    image: mitPhoto,
    alt: 'León Palafox with fellow panelists at AI Top Business Leaders México.',
    href: 'https://www.technologyreview.es/article/leon-palafox-el-valor-de-la-ia-empieza-por-conectar-con-quienes-conocen-el-negocio',
  },
  {
    outlet: 'WIRED en Español',
    date: 'July 28, 2026',
    datetime: '2026-07-28',
    title: 'La IA agéntica llegó a México sin reglas ni garantías',
    description: 'On data privacy, regulatory gaps, and the safeguards still missing as autonomous AI agents begin operating in Mexico.',
    image: wiredHero,
    alt: 'WIRED illustration of AI agents working at screens above the Mexico City skyline.',
    href: 'https://es.wired.com/articulos/la-ia-agentica-llego-a-mexico-sin-reglas-ni-garantias',
  },
];

const spotlights = [
  {
    label: 'NVIDIA',
    logo: nvidiaLogo,
    logoWidth: 150,
    outlet: 'NVIDIA Developer Blog',
    title: 'From deep learning to the surface of Mars.',
    image: nvidiaHero,
    alt: 'Mars terrain and neural network diagrams from NVIDIA’s feature on deep learning for planetary science.',
    href: 'https://developer.nvidia.com/blog/deep-learning-image-understanding-planetary-science/',
  },
  { ...featured[0], label: 'MIT Technology Review', logo: mitLogo, logoWidth: 240, lang: 'es' },
  { ...featured[1], label: 'WIRED', logo: wiredLogo, logoWidth: 130, lang: 'es' },
  {
    label: 'Mexico Business News',
    logo: mbnLogo,
    logoWidth: 105,
    outlet: 'Mexico Business News',
    title: 'From AI Hype to Business Impact: Why Corporate AI Breaks',
    image: mbnHero,
    alt: 'León Palafox speaking at the Mexico AI, Cloud & Data Summit 2026. Photo: Mexico Business News.',
    href: 'https://mexicobusiness.news/cloudanddata/news/ai-hype-business-impact-why-corporate-ai-breaks',
  },
];

const recentPosts = (await getCollection('blog'))
  .filter((post) => post.data.tags.includes('financiero'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const postDate = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="León Palafox — Media, Talks & Interviews"
  description="Media appearances, interviews, talks, and public writing by León Palafox on AI, machine learning, data science, and financial technology."
>
  <MediaSpotlight slides={spotlights} />

  <nav aria-label="Media sections" class="media-navigation border-b border-hairline bg-paper px-6 py-7 sm:px-10 lg:px-14">
    {[
      ['Press', '#press'], ['Podcasts & talks', '#talks'], ['Columns', '#columns'],
      ['Research', '#research-highlights'], ['Latest writing', '#latest-writing'],
    ].map(([label, href], index) => (
      <a href={href} class="media-navigation-link">
        <span class="micro-label media-navigation-number" aria-hidden="true">0{index + 1}</span>
        <span class="media-navigation-label">{label}</span>
        <span class="media-navigation-arrow" aria-hidden="true">↓</span>
      </a>
    ))}
  </nav>

  <section aria-label="Selected media outlets" class="border-b border-hairline bg-paper px-6 py-8 sm:px-10 lg:px-14">
    <p class="micro-label text-muted">Featured in &amp; writing for</p>
    <ul class="publication-logos mt-6">
      {publications.map((publication) => (
        <li>
          <a href={publication.href} class="publication-logo" aria-label={`${publication.name} — see coverage`}>
            <Image
              src={publication.logo}
              alt={publication.name}
              width={publication.width}
              loading="lazy"
              class:list={['publication-logo-image', { 'publication-logo-boxed': publication.name === 'Expansión' }]}
            />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="press" class="media-section border-b border-hairline">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading title="In the press" id="press" />
      <p class="micro-label text-muted">Interviews / profiles / commentary</p>
    </div>

    <a href="https://mexicobusiness.news/cloudanddata/news/ai-hype-business-impact-why-corporate-ai-breaks" class="group mt-8 grid items-center gap-6 border border-hairline bg-paper p-5 transition-colors hover:border-signal md:grid-cols-2 md:gap-8 lg:p-7">
      <Image
        src={mbnHero}
        alt="León Palafox speaking at the Mexico AI, Cloud & Data Summit 2026. Photo: Mexico Business News."
        widths={[480, 720, 1072]}
        sizes="(min-width: 1024px) 44vw, (min-width: 768px) 46vw, 90vw"
        quality={80}
        loading="lazy"
        class="aspect-[4/3] w-full border border-hairline object-cover"
      />
      <div>
        <p class="micro-label text-signal-deep">Latest appearance</p>
        <p class="mt-3 text-lg font-semibold">Mexico Business News</p>
        <time datetime="2026-10-20" class="mt-2 block text-sm text-muted">October 20, 2026</time>
        <h3 class="mt-4 text-2xl font-semibold leading-tight tracking-tight transition-colors group-hover:text-signal-deep">From AI Hype to Business Impact: Why Corporate AI Breaks</h3>
        <p class="mt-4 leading-relaxed text-muted">Why corporate AI projects stall, how the gap between IT and the business erodes value, and what it takes to turn AI into business impact.</p>
        <span class="media-link mt-5">Read the article <span aria-hidden="true">↗</span></span>
      </div>
    </a>

    <div class="mt-8 grid gap-8 md:grid-cols-2">
      {featured.map((item) => (
        <a href={item.href} class="group flex flex-col border border-hairline bg-paper transition-colors hover:border-signal">
          <div class="overflow-hidden border-b border-hairline">
            <Image src={item.image} alt={item.alt} widths={[480, 720, 1080]} sizes="(min-width: 1024px) 44vw, (min-width: 768px) 46vw, 90vw" quality={75} loading="lazy" class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]" />
          </div>
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <p class="micro-label leading-relaxed text-signal-deep">{item.outlet}</p>
            <time datetime={item.datetime} class="mt-3 text-sm text-muted">{item.date}</time>
            <h3 lang="es" class="mt-4 text-2xl font-semibold leading-snug tracking-tight">{item.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-muted">{item.description}</p>
            <span class="media-link mt-auto pt-6">Read the story <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>

    <details class="press-archive mt-8 border-y border-hairline">
      <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 font-medium">
        More press coverage <span class="micro-label text-signal-deep">Archive <span aria-hidden="true" class="archive-toggle ml-2 inline-block">+</span></span>
      </summary>
      <div class="pb-6">
        {press.map((group) => (
          <div class="mt-6 grid gap-3 sm:grid-cols-[5rem_1fr] sm:gap-6">
            <h3 class="micro-label pt-4 text-signal-deep">{group.year}</h3>
            <ul class="divide-y divide-hairline">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="group flex items-start gap-4 py-4">
                    <span class="micro-label w-14 shrink-0 pt-1 text-muted">{item.date}</span>
                    <span class="min-w-0 flex-1">
                      <span lang="es" class="font-medium leading-snug group-hover:text-signal-deep">{item.title}</span>
                      <span class="mt-2 block text-sm text-muted">{item.outlet}</span>
                      <span lang="es" class="mt-2 block text-sm leading-relaxed text-muted">{item.note}</span>
                    </span>
                    <span aria-hidden="true" class="text-signal-deep">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </details>
  </section>

  <section aria-labelledby="talks" class="media-section border-b border-hairline">
    <SectionHeading title="Behind the microphone" id="talks" />
    <p class="mt-6 max-w-2xl leading-relaxed text-muted">Longer conversations on data, the possibilities of AI, and the people putting it to work.</p>
    <div class="mt-8 grid border-l border-t border-hairline md:grid-cols-2">
      {talks.map((talk, index) => (
        <a href={talk.href} class="group flex gap-5 border-b border-r border-hairline p-6 transition-colors hover:bg-paper sm:p-8">
          <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full border border-hairline text-signal-deep">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="m6 3 7 5-7 5V3Z" fill="currentColor" /></svg>
          </span>
          <div class="flex min-w-0 flex-1 flex-col">
            <p class="micro-label leading-relaxed text-muted">{talk.outlet}</p>
            <h3 lang="es" class="mt-3 text-xl font-semibold leading-snug tracking-tight group-hover:text-signal-deep">{talk.title}</h3>
            <span class="media-link mt-auto pt-6">{index === 0 ? 'Explore the session' : index === 3 ? 'Watch the talk' : 'Listen to the conversation'} <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="columns" class="media-section border-b border-hairline">
    <div class="grid gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-12">
      <div>
        <SectionHeading title="A regular point of view" id="columns" />
        <p class="mt-6 font-serif text-3xl italic">El Financiero</p>
        <p class="mt-4 leading-relaxed text-muted">My column on the business impact of AI, digital sovereignty, and technical strategy. Written from Mexico, with a global perspective.</p>
        <a href="/blog/" class="media-link mt-6">Explore all writing <span aria-hidden="true">→</span></a>
      </div>
      <div>
        {columns.map((group) => (
          <div class="mb-8 last:mb-0">
            <h3 class="micro-label text-signal-deep">{group.year}</h3>
            <ul class="mt-3 divide-y divide-hairline border-t border-hairline">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="group flex items-baseline gap-4 py-4">
                    <span class="micro-label w-14 shrink-0 text-muted">{item.date}</span>
                    <span lang="es" class="min-w-0 flex-1 leading-snug group-hover:text-signal-deep">{item.title}</span>
                    <span aria-hidden="true" class="shrink-0 text-signal-deep">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="research-highlights" class="media-section border-b border-hairline">
    <SectionHeading title="Research in the spotlight" id="research-highlights" />
    <a href="https://developer.nvidia.com/blog/deep-learning-image-understanding-planetary-science/" class="group mt-8 grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <Image src={nvidiaHero} alt="Mars terrain and neural network diagrams from NVIDIA’s feature on deep learning for planetary science." widths={[480, 720, 1080]} sizes="(min-width: 1024px) 44vw, 90vw" quality={75} loading="lazy" class="w-full border border-hairline" />
      <div>
        <p class="micro-label text-signal-deep">NVIDIA Developer Blog</p>
        <h3 class="mt-4 text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">From deep learning to the surface of Mars.</h3>
        <p class="mt-4 leading-relaxed text-muted">NVIDIA interviewed me about MarsNet, our work at the University of Arizona’s Lunar and Planetary Laboratory using convolutional neural networks to identify land features in HiRISE imagery.</p>
        <time datetime="2015-05-12" class="mt-4 block text-sm text-muted">May 12, 2015</time>
        <span class="media-link mt-6">Read the research feature <span aria-hidden="true">↗</span></span>
      </div>
    </a>
  </section>

  <section aria-labelledby="latest-writing" class="media-section border-b border-hairline">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <SectionHeading title="Latest writing" id="latest-writing" />
      <a href="/blog/" class="media-link">All articles <span aria-hidden="true">→</span></a>
    </div>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {recentPosts.map((post) => (
        <a href={`/blog/${post.id}/`} class="group flex flex-col border-t border-hairline pt-5">
          {post.data.cover && <Image src={getAsset(post.data.cover, { alt: '' }).src} alt="" widths={[360, 720]} sizes="(min-width: 768px) 30vw, 90vw" loading="lazy" class="mb-5 aspect-[4/3] w-full border border-hairline object-cover" />}
          <time datetime={post.data.pubDate.toISOString()} class="micro-label leading-relaxed text-muted">{postDate.format(post.data.pubDate)}</time>
          <h3 lang={post.data.lang} class="mt-3 text-xl font-semibold leading-snug tracking-tight group-hover:text-signal-deep">{post.data.title}</h3>
          <span class="media-link mt-auto pt-5">Read the column <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="media-inquiries" class="media-section bg-paper">
    <div class="grid items-center gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <p class="micro-label text-signal-deep">Let’s talk / お問い合わせ</p>
        <h2 id="media-inquiries" class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">Have a conversation in mind?</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-muted">For interviews, podcast appearances, and speaking engagements on AI, data strategy, and financial technology, get in touch.</p>
      </div>
      <a href="mailto:leon.palafox@gmail.com?subject=Media%20%26%20speaking%20inquiry" class="media-button justify-self-start">Start a conversation <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<style>
  .media-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .media-navigation-link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: space-between;
    gap: 1rem 0.5rem;
    min-height: 7rem;
    padding: 1rem;
    border: 1px solid var(--color-hairline);
    border-top: 3px solid var(--color-signal-deep);
    background: var(--color-sheet);
    color: var(--color-ink);
    transition: background-color 150ms, border-color 150ms, color 150ms;
  }
  .media-navigation-link:last-child {
    grid-column: 1 / -1;
  }
  .media-navigation-number {
    grid-column: 1 / -1;
    color: var(--color-signal-deep);
  }
  .media-navigation-label {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
