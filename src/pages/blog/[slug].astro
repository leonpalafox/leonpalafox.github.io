---
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCover from '../../components/PostCover.astro';
import { getAsset } from '../../lib/assets';
import { fullDate, kanjiYear } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, lang, tags, cover, coverAlt, coverCaption, source, sourceName, translation } =
  post.data;

const asset = cover ? getAsset(cover, { alt: coverAlt, caption: coverCaption }) : null;
// A post with cover art gets its own social preview instead of the site-wide one.
const ogImage = asset ? (await getImage({ src: asset.src, width: 1200 })).src : undefined;

// BlogPosting structured data, linked to the site-wide Person via its @id.
const personId = new URL('#person', Astro.site).toString();
const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description ?? title,
  datePublished: pubDate.toISOString(),
  inLanguage: lang === 'es' ? 'es-MX' : 'en-US',
  author: { '@id': personId },
  publisher: { '@type': 'Organization', name: 'León Palafox', url: Astro.site.toString() },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site).toString(),
  image: new URL(ogImage ?? '/images/og-default.jpg', Astro.site).toString(),
  wordCount: post.body ? post.body.trim().split(/\s+/).length : undefined,
};

const t = {
  es: { back: 'Todas las entradas', original: 'Publicado originalmente en' },
  en: { back: 'All posts', original: 'Originally published in' },
}[lang];
const translationLabel = translation?.label ?? (translation?.lang === 'en' ? 'Read in English' : 'Leer en español');
---

<Base title={`${title} — León Palafox`} description={description ?? title} lang={lang} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
  <article class="px-6 py-14 sm:px-10 lg:px-14 lg:py-20">
    <header class="mx-auto max-w-2xl">
      <p class="micro-label flex items-center gap-3 text-signal-deep">
        <time datetime={pubDate.toISOString().slice(0, 10)}>{fullDate(pubDate, lang)}</time>
        <span lang="ja" class="text-muted tracking-[0.2em]">{kanjiYear(pubDate)}</span>
      </p>
      <h1 class="mt-5 text-3xl font-semibold leading-[1.08] tracking-[-0.02em] sm:text-4xl lg:text-[2.75rem]">
        {title}
      </h1>
      <span aria-hidden="true" class="mt-6 block h-[3px] w-14 bg-signal"></span>
      {
        tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="micro-label border border-hairline px-2.5 py-1 text-muted">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {asset && <PostCover asset={asset} />}

    <div class="prose-post mx-auto mt-12 max-w-2xl">
      <Content />
    </div>

    <footer class="mx-auto mt-16 max-w-2xl border-t border-hairline pt-8">
      {
        (source || translation) && (
          <ul class="mb-8 space-y-3">
            {translation && (
              <li>
                <a
                  href={translation.url}
                  lang={translation.lang}
                  rel="alternate"
                  hreflang={translation.lang}
                  class="group micro-label inline-flex items-center gap-2 text-signal-deep hover:text-signal"
                >
                  {translationLabel}
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
                    ↗
                  </span>
                </a>
              </li>
            )}
            {source && (
              <li class="micro-label text-muted">
                {t.original}{' '}
                <a href={source} class="text-signal-deep hover:text-signal">
                  {sourceName ?? new URL(source).hostname.replace(/^www\./, '')}
                </a>
              </li>
            )}
          </ul>
        )
      }

      <a href="/blog/" class="group micro-label inline-flex items-center gap-2 text-signal-deep hover:text-signal">
        <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
        {t.back}
      </a>
    </footer>
  </article>
</Base>
