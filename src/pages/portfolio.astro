---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection } from 'astro:content';

// The poll is re-run every week of the season; say how far it has got.
const nflEditions = (await getCollection('blog', (post) => post.data.tags.includes('nfl'))).length;

const projects = [
  {
    year: '2026',
    title: 'NFL Power Rankings Poll of Polls',
    description:
      'Nine outlets publish a power ranking every week and disagree. This pools them into one statistically explicit consensus, charts every team\u2019s movement, and simulates a path to the Super Bowl, with the Python pipeline documented.',
    note: `Updated weekly \u00b7 ${nflEditions} editions so far`,
    href: '/blog/nfl-power-rankings-poll-of-polls/',
  },
  {
    year: '2026',
    title: 'PISA 2025 score shifts',
    description:
      'An interactive map of PISA score changes, OECD decennial trends, and uncertainty across participating education systems.',
    href: '/pisa_results/',
  },
  {
    year: '2026',
    title: 'World Cup managers: rank vs tenure',
    description:
      'An interactive bubble chart of the 48 teams headed to the 2026 World Cup, comparing FIFA ranking, how long each manager has been in charge, and titles won.',
    href: '/blog/world-cup-managers-rank-vs-tenure/',
  },
];
---

<Base
  title="León Palafox — Portfolio"
  description="Interactive data visualizations and applied research projects by León Palafox."
>
  <PageHero
    eyebrow="Portfolio"
    jp="作品"
    title="Selected projects"
    description="Interactive work that makes complex data easier to explore and inspect."
  />

  <section class="px-6 py-14 sm:px-10 lg:px-14">
    <SectionHeading title="Data visualization" id="data-visualization" />
    <ul class="mt-8 max-w-3xl divide-y divide-hairline">
      {
        projects.map((project) => (
          <li>
            <a href={project.href} class="group flex items-start gap-5 py-5">
              <span class="micro-label mt-1 w-16 shrink-0 text-muted">{project.year}</span>
              <span class="flex-1">
                <span class="block text-lg font-medium leading-snug">{project.title}</span>
                <span class="mt-2 block leading-relaxed text-muted">{project.description}</span>
                {project.note && <span class="micro-label mt-3 block text-signal-deep">{project.note}</span>}
              </span>
              <span aria-hidden="true" class="mt-1 shrink-0 text-signal-deep transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-hairline px-6 py-14 sm:px-10 lg:px-14">
    <SectionHeading title="U.S. elections" id="us-elections" />
    <p class="mt-6 max-w-2xl text-[1.05rem] leading-relaxed text-muted">
      Senate, governor and presidential results, state by state. Hover any state for the winner and margin; the
      tabs switch between the 2026 Senate and governor races and the 2024 presidential map.
    </p>
    <div class="mx-auto mt-8 max-w-[1060px] border border-hairline bg-white">
      <iframe
        id="us-elections-frame"
        src="/portfolio/us-elections.html"
        title="U.S. election results maps: 2026 Senate, 2026 governors and 2024 president"
        loading="lazy"
        class="block w-full border-0"
        style="height: 850px"
      ></iframe>
    </div>
    <div class="mx-auto mt-4 flex max-w-[1060px] flex-wrap items-center justify-between gap-3">
      <p class="micro-label text-muted">2026 Senate &amp; governors · 2024 presidential</p>
      <a
        href="/portfolio/us-elections.html"
        target="_blank"
        rel="noopener"
        class="group micro-label inline-flex items-center gap-2 text-signal-deep hover:text-signal"
      >
        Open full screen
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
      </a>
    </div>
  </section>
</Base>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('#us-elections-frame');
  if (frame) {
    const ready = () => {
      const doc = frame.contentDocument;
      return doc && doc.readyState === 'complete' && doc.body && doc.body.scrollHeight >= 10 ? doc : null;
    };
    const fit = () => {
      const doc = ready();
      if (doc) frame.style.height = `${doc.body.scrollHeight}px`;
    };
    const attach = () => {
      const doc = ready();
      if (!doc) return;
      fit();
      if (!frame.dataset.observed) {
        new ResizeObserver(fit).observe(doc.body);
        frame.dataset.observed = 'true';
      }
    };
    frame.addEventListener('load', attach);
    attach();
    window.addEventListener('resize', fit);
  }
</script>
